# EduTrack Environment Configuration Template
# Copy these variables into your process environment (or a .env file loaded by
# your process manager). NEVER commit production secrets.

# --- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
# MUST be False in production.
DJANGO_DEBUG=False
# Exact production hostnames only; never use '*' in production.
DJANGO_ALLOWED_HOSTS=edutrack.example.edu
# Exact scheme+host origins that serve the app (needed behind a proxy).
DJANGO_CSRF_TRUSTED_ORIGINS=https://edutrack.example.edu

# --- Transport / sessions ---------------------------------------------------
# Set True when TLS termination happens on a proxy in front of Django.
DJANGO_BEHIND_PROXY=False
DJANGO_SESSION_COOKIE_AGE=43200
DJANGO_HSTS_SECONDS=31536000

# --- Database ---------------------------------------------------------------
# SQLite is used when unset or "sqlite" (development only).
DJANGO_DB_ENGINE=postgres
DJANGO_DB_NAME=edutrack
DJANGO_DB_USER=edutrack
DJANGO_DB_PASSWORD=change-me
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432
DJANGO_DB_CONN_MAX_AGE=60

# --- Email (password reset / notifications) ---------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=EduTrack Notifications <noreply@example.edu>

# --- Logging ----------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
